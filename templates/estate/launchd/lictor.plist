<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hourly. The Lictor reads every board and every PR and writes
     brain/lictor/<stamp>.md; no model wakes. A cloud routine running
     prompts/lictor-cloud.md is the alternative when this machine sleeps;
     install one or the other, not both. -->
<plist version="1.0"><dict>
  <key>Label</key><string>curia.{{ESTATE_KEY}}.lictor</string>
  <key>ProgramArguments</key><array>
    <string>{{MECHANISM}}/bin/curia</string><string>--estate</string><string>{{ESTATE_DIR}}</string><string>lictor</string><string>--write</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/Users/USER/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>{{ESTATE_DIR}}/brain/lictor/launchd.log</string>
  <key>StandardErrorPath</key><string>{{ESTATE_DIR}}/brain/lictor/launchd.log</string>
</dict></plist>
