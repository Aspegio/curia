def cmd_help(a) -> None:
    if a.command:
        choices = a.subparsers.choices
        if a.command not in choices:
            die(f"no command '{a.command}'; `curia help` lists them")
        choices[a.command].print_help()
        return
    print(HELP_OVERVIEW)


# ------------------------------------------------------------------- init

def cmd_init(a) -> None:
    target = Path(a.path).expanduser().resolve()
    curia = target / "curia"
    if curia.exists():
        die(f"{curia} already exists")
    key = a.name.lower().replace(" ", "_")
    if ESTATES_FILE.exists():
        registered = load_toml(ESTATES_FILE).get("estates", {})
        if key in registered:
            die(f"an estate '{key}' is already registered in {ESTATES_FILE}")
        for k, e in registered.items():
            if Path(e.get("path", "")).expanduser().resolve() == curia:
                die(f"{curia} is already registered as estate '{k}' in {ESTATES_FILE}")
    shutil.copytree(MECHANISM_DIR / "templates" / "estate", curia)
    for p in curia.rglob("*"):
        if p.is_file() and p.suffix in {".toml", ".md", ".plist", ".json"}:
            p.write_text(p.read_text().replace("{{ESTATE}}", a.name).replace("{{PRINCIPAL}}", a.principal)
                         .replace("{{ESTATE_DIR}}", str(curia)).replace("{{MECHANISM}}", str(MECHANISM_DIR)))
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(ESTATES_FILE, "a") as f:
        f.write(f'\n[estates.{key}]\npath = "{curia}"\n')
    print(f"estate '{a.name}' created at {curia} and registered in {ESTATES_FILE}\n"
          "Next: fill roster.toml, repos.toml, accounts.toml; write seats/<seat>/charter.md; run `curia check`.")


# ------------------------------------------------------------------- main

def main() -> None:
    ap = argparse.ArgumentParser(prog="curia", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--estate", help="path to <workspace>/curia (default: CURIA_ESTATE, cwd walk-up, the registered estate whose roster "
                    "has the seat named, or the only one registered)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    def parser(name: str, summary: str) -> argparse.ArgumentParser:
        return sub.add_parser(name, help=summary, description=HELP_DETAIL.get(name),
                              epilog=HELP_EXAMPLES.get(name),
                              formatter_class=argparse.RawDescriptionHelpFormatter)

    parser("roster", "list seats").set_defaults(fn=cmd_roster)
    parser("repos", "list repos and their beads exports").set_defaults(fn=cmd_repos)
    parser("accounts", "list accounts and limit state").set_defaults(fn=cmd_accounts)
    parser("rulings", "the brain's rulings: status and what enforces each").set_defaults(fn=cmd_rulings)
    parser("check", "validate the estate's configuration").set_defaults(fn=cmd_check)
    parser("status", "who is awake, whose memory is how old, what the offices last said, what was spent"
           ).set_defaults(fn=cmd_status)

    p = parser("prime", "print the system-prompt prime a seat wakes up with")
    p.add_argument("seat", help="a seat name from roster.toml (any case)"); p.set_defaults(fn=cmd_prime)

    p = parser("launch", "wake a seat interactively (crew or office)")
    p.add_argument("seat", help="a seat name from roster.toml (any case)")
    p.add_argument("--repo", action="append",
                   help="start in this repo (default: the repo you are in, else the seat's home); "
                        "with --everything, repeatable: the boards to work, in that order")
    p.add_argument("--loop", action="store_true", help="relaunch after a /handoff (RESTART marker)")
    p.add_argument("--account", help="start on this account instead of the seat's, e.g. one with headroom")
    p.add_argument("--tmux", action="store_true", help="open in a new tmux window named after the seat")
    p.add_argument("--say", help="opening message for the seat, e.g. tonight's orders")
    p.add_argument("--carry", action="store_true",
                   help="experimental, with --loop: after a mid-session limit, copy the cut session's transcript "
                        "to the next account and --resume it there")
    p.add_argument("--everything", action="store_true",
                   help="work the repo's board, or each --repo's in turn, until nothing remains that is not "
                        "waiting on a human (implies --loop)")
    p.add_argument("--until", help="end the night at this time: HH:MM local, or ISO datetime (UTC assumed if naive); "
                   "requires --loop or --everything")
    p.add_argument("--budget", help="end the night when recorded spend reaches this USD amount; "
                   "requires --loop or --everything")
    p.add_argument("--print-cmd", dest="print_cmd", action="store_true", help="show what would run, without launching")
    p.set_defaults(fn=cmd_launch)

    p = parser("run", "headless run of a seat with a prompt file; how an office wakes a crew seat")
    p.add_argument("seat", help="the seat to run: an office, or a crew seat an office is waking")
    p.add_argument("--prompt", required=True, help="file in the estate's prompts/, or a path")
    p.add_argument("--repo", help="run in this repo (default: the repo you are in, else the estate root); its repos.toml values become {placeholders}")
    p.add_argument("--set", action="append", help="key=value substitution for the prompt (repeatable)")
    p.add_argument("--bead", action="append",
                   help="the bead(s) this run is about (repeatable, or comma-separated); recorded with the run's "
                        "cost in the seat's assignments.log so spend attaches to work. --set bead=<id> does the same")
    p.add_argument("--timeout", type=int, default=3600,
                   help="seconds before the run is cut off, with everything it started (default 3600)")
    p.add_argument("--skip-permissions", action="store_true",
                   help="run with --dangerously-skip-permissions instead of the seat's tool list")
    p.add_argument("--model", help="model for this run only; default: the seat's run_model from the roster, else its model")
    p.add_argument("--detach", action="store_true",
                   help="return at once with the pid and the log path; the run (its own process either way) "
                        "finishes its record without you. Default: wait and print the answer when it ends")
    p.add_argument("--print-cmd", dest="print_cmd", action="store_true", help="show account, model, cwd and prompt size without running")
    p.set_defaults(fn=cmd_run)

    p = parser("dispatch", "give a fleet worker a worktree of its own and a job there; --review adds a reviewer")
    p.add_argument("seat", help="a fleet seat from roster.toml")
    p.add_argument("--bead", required=True, help="the bead to implement; the branch is <seat>/<bead>")
    p.add_argument("--repo", help="the repo to work in (default: the repo you are in)")
    p.add_argument("--prompt", help="the worker's brief: a file in the estate's prompts/, or a path (default dispatch.md)")
    p.add_argument("--review", help="after the worker returns, wake this seat headless in the worktree to review")
    p.add_argument("--review-prompt", dest="review_prompt", help="the reviewer's brief (default review.md)")
    p.add_argument("--timeout", type=int, default=3600,
                   help="seconds before a waking is cut off, with everything it started (default 3600)")
    p.add_argument("--skip-permissions", action="store_true",
                   help="run with --dangerously-skip-permissions instead of the seat's tool list")
    p.add_argument("--model", help="the worker's model for this job only (default: its run_model, else model)")
    p.add_argument("--detach", action="store_true",
                   help="return at once with the pid and the log path; the job (its own process either way) "
                        "finishes its record without you. Default: wait and print the answers when it ends")
    p.add_argument("--print-cmd", dest="print_cmd", action="store_true",
                   help="show the worktree, branch, account and brief without touching git or running")
    p.set_defaults(fn=cmd_dispatch)

    p = parser("handoff", "show a seat's handoff; --begin/--done belong to the /handoff skill")
    p.add_argument("seat", help="the seat whose handoff to show"); g = p.add_mutually_exclusive_group()
    g.add_argument("--begin", action="store_true", help="archive the old note; say where the new one goes")
    g.add_argument("--done", action="store_true", help="confirm the note is written; mark the seat ready to relaunch")
    p.set_defaults(fn=cmd_handoff)

    p = parser("laurel", "record spontaneous praise for a seat's work")
    p.add_argument("seat", help="the seat being praised")
    p.add_argument("text", help="the praise, one line, quoted"); p.set_defaults(fn=cmd_laurel)

    p = parser("mail", "leave a seat a note for its next waking; the seat archives it once read")
    p.add_argument("seat", nargs="?", help="the seat to write to (with --all, the text)")
    p.add_argument("text", nargs="?", help="the note, quoted; omit it to read the seat's unread mail")
    p.add_argument("--all", action="store_true", help="every active seat but the sender")
    p.add_argument("--archive", action="store_true", help="the seat has read its mail: move it to history/")
    p.set_defaults(fn=cmd_mail)

    p = parser("limit", "mark an account as usage-limited so launches fall back")
    p.add_argument("account", help="account name, or 'current' to resolve from CLAUDE_CONFIG_DIR")
    p.add_argument("--hours", type=float, help="limited for this many hours from now")
    p.add_argument("--until", help="limited until this ISO timestamp (UTC assumed)")
    p.add_argument("--clear", action="store_true", help="remove the marker early")
    p.set_defaults(fn=cmd_limit)

    p = parser("lictor", "read-only nudge report across every repo (crons watch)")
    p.add_argument("--stale-days", type=int, default=2, help="in_progress is stale after this many days (default 2)")
    p.add_argument("--pr-hours", type=int, default=24, help="a PR or draft is silent after this many hours (default 24)")
    p.add_argument("--postmortem-days", dest="postmortem_days", type=int, default=7,
                   help="an open postmortem bead no ruling cites is nudged after this many days (default 7)")
    p.add_argument("--ruling-days", dest="ruling_days", type=int, default=14,
                   help="an enacted ruling nothing enforces is nudged after this many days (default 14)")
    p.add_argument("--write", action="store_true", help="save to brain/lictor/ instead of printing")
    p.set_defaults(fn=cmd_lictor)

    p = parser("censor", "check each integration branch; wake the Censor where red (models act)")
    p.add_argument("--dry-run", action="store_true", help="print branch states; wake nobody, write nothing")
    p.add_argument("--timeout", type=int, default=5400, help="seconds per repo before a waking is cut off (default 5400)")
    p.add_argument("--skip-permissions", action="store_true",
                   help="run with --dangerously-skip-permissions instead of the seat's tool list")
    p.set_defaults(fn=cmd_censor)

    p = parser("portcullis", "the land gate: merge the seats' PRs that are reviewed, green and mergeable; close their beads")
    p.add_argument("--dry-run", action="store_true", help="say what would land and why the rest would not; merge nothing, write nothing")
    p.add_argument("--label", help="the label that says reviewed (default: estate.toml land_label, else 'reviewed')")
    p.set_defaults(fn=cmd_portcullis)

    p = parser("reap", "close the record of sessions whose launcher is gone; remove worktrees whose branch has landed")
    p.add_argument("--dry-run", action="store_true", help="say what would go; touch nothing")
    p.set_defaults(fn=cmd_reap)

    p = parser("ingest", "capture beads from meeting notes: wake the intake office on the transcript(s)")
    p.add_argument("sources", nargs="*", help="transcript file(s); quote paths with spaces; '-' reads stdin")
    p.add_argument("--paste", "-p", action="store_true", help="take the transcript from the clipboard (pbpaste)")
    p.add_argument("--repo", help="the notes concern this repo: start there, file there by default (default: the product repo you are in)")
    p.add_argument("--account", help="start on this account instead of the office's, e.g. one with headroom")
    p.add_argument("--tmux", action="store_true", help="open in a new tmux window")
    p.add_argument("--print-cmd", dest="print_cmd", action="store_true", help="show what would run, without launching")
    p.set_defaults(fn=cmd_ingest)

    p = parser("rename", "rename a seat, keeping its history (a ceremony, not a find-and-replace)")
    p.add_argument("old", help="the seat's current name")
    p.add_argument("new", help="the new name: a bare word, not yet on the roster")
    p.add_argument("--title", help="display title (default: the new name, capitalised)")
    p.set_defaults(fn=cmd_rename)

    p = parser("hook", "what a seat session's Claude Code hooks run (launch installs them)")
    p.add_argument("event", help="the hook: precompact, shift, limited, usage, release-guard")
    p.set_defaults(fn=cmd_hook)

    p = parser("init", "create a new estate from the template")
    p.add_argument("path", help="workspace directory; the estate lands at <path>/curia")
    p.add_argument("--name", required=True, help="the estate's name")
    p.add_argument("--principal", required=True, help="whose estate it is")
    p.set_defaults(fn=cmd_init)

    p = parser("help", "the vocabulary and the rhythm; `help <command>` for one in full")
    p.add_argument("command", nargs="?", help="a command to explain in full")
    p.set_defaults(fn=cmd_help, subparsers=sub)

    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
